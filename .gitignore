# Build output
/bin/
/dist/
*.exe
*.test
*.out
coverage.*

# Web UI: dependencies and build output. Only the placeholder index.html of
# web/dist is tracked (go:embed needs it); `make web` overwrites it locally,
# do not commit the built version (see CONTRIBUTING.md).
web/node_modules/
web/dist/*
!web/dist/index.html
web/*.tsbuildinfo

# Desktop (Wails) build output
cmd/adesc-desktop/build/bin/

# Go fuzz corpus written next to the package
**/testdata/fuzz/

# Local runtime data and secrets
*.db
*.db-shm
*.db-wal
*.lock
config.toml
cookies.txt
.env

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

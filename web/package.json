{
  "name": "admindescargas-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Web UI de AdminDescargas (Svelte 5 + Vite 6 + TS). Compartida por la Web UI embebida y la app de escritorio.",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",

    "@fontsource/geist": "~5.2.8",
    "@fontsource/geist-mono": "~5.2.8",
    "@fontsource/inter": "~5.2.8",
    "@fontsource/jetbrains-mono": "~5.2.8",
    "@fontsource/manrope": "~5.2.8",
    "@sveltejs/vite-plugin-svelte": "~5.1.1",
    "@tsconfig/svelte": "~5.0.4",
    "svelte": "~5.59.1",
    "svelte-check": "~4.3.0",
    "typescript": "~5.9.3",
    "vite": "~6.4.1",
    "vitest": "~3.2.4"
  }
}

# npm run dev:mock (vite --mode mock): in-browser mock API, no daemon needed.
# Add VITE_MOCK_LOGIN=1 to test the login screen (password: admin).
# VITE_MOCK_VAULT picks the secret store: locked (default; master password
# demo1234), unlocked, new (first unlock creates it), keyring or memory.
VITE_MOCK=1
